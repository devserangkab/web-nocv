# Template .env deployment Docker (production, LAN-only).
# Salin ke .env di server, isi, lalu: docker compose up -d --build --remove-orphans
# Nilai di file ini dibaca docker-compose.yml (interpolasi) DAN Laravel (.env di-mount).

# --- Aplikasi ---
APP_NAME=NOCV
APP_ENV=production
APP_DEBUG=false
APP_URL=http://192.168.1.199:9446
APP_KEY=
APP_PORT=9446
LOG_LEVEL=error
TZ=Asia/Jakarta

# --- Octane ---
OCTANE_MAX_REQUESTS=500
OCTANE_WORKERS=

# --- Database: numpang MariaDB stack "bahagia" ---
DB_CONNECTION=mysql
DB_HOST=bahagia-mariadb        # nama container DB stack bahagia (cek: docker ps)
DB_PORT=3306
DB_DATABASE=nocv
DB_USERNAME=nocv
DB_PASSWORD=
DB_NETWORK=bahagia_default     # nama network Docker stack bahagia (cek: docker inspect)

# --- Lain ---
QUEUE_CONNECTION=sync          # jangan 'database' sebelum ada container worker
SECURE_KEY=                    # base64 32 bytes TANPA prefix: openssl rand -base64 32
