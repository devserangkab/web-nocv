# Template .env deployment Docker (production, LAN-only).
# Web hanya via central reverse proxy: https://nocv.serangkab.go.id (TLS Sectigo di central Caddy).
# Salin ke .env di server, isi, lalu: docker compose up -d --build --remove-orphans
# Nilai di file ini dibaca docker-compose.yml (interpolasi) DAN Laravel (.env di-mount).

# --- Aplikasi ---
APP_NAME=NOCV
APP_ENV=production
APP_DEBUG=false
APP_URL=https://nocv.serangkab.go.id
APP_KEY=
APP_PORT=80                    # port HTTP internal — samakan dengan upstream central Caddyfile (nocv-app:80)
LOG_LEVEL=error
TZ=Asia/Jakarta

# --- Octane ---
OCTANE_MAX_REQUESTS=500
OCTANE_WORKERS=

# --- Database: central MariaDB ---
DB_CONNECTION=mysql
DB_HOST=central_mariadb        # nama container central MariaDB (cek: docker ps)
DB_PORT=3306
DB_DATABASE=nocv
DB_USERNAME=nocv
DB_PASSWORD=
DB_NETWORK=db_net              # nama network Docker central MariaDB (cek: docker inspect)

# --- Network central reverse proxy ---
PROXY_NETWORK=proxy_net

# --- Lain ---
QUEUE_CONNECTION=sync          # jangan 'database' sebelum ada container worker
SECURE_KEY=                    # base64 32 bytes TANPA prefix: openssl rand -base64 32
