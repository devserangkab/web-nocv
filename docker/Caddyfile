{
	{$CADDY_GLOBAL_OPTIONS}

	admin {$CADDY_SERVER_ADMIN_HOST}:{$CADDY_SERVER_ADMIN_PORT}

	frankenphp {
		worker {
			file "{$APP_PUBLIC_PATH}/frankenphp-worker.php"
			{$CADDY_SERVER_WORKER_DIRECTIVE}
		}
	}
}

# HTTP saja — diakses lewat central reverse proxy (upstream nocv-app:APP_PORT).
# Menerima Host apa pun; TLS diurus central Caddy.
http://:{$APP_PORT:80} {
	log {
		level {$CADDY_SERVER_LOG_LEVEL}

		format filter {
			wrap {$CADDY_SERVER_LOGGER}
			fields {
				request>uri query {
					replace authorization REDACTED
				}
			}
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-X-Powered-By
	}

	# Aset Vite yang sudah di-hash tidak pernah berubah
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	route {
		root * "{$APP_PUBLIC_PATH}"
		encode zstd br gzip

		php_server {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			# symlink public/storage
			resolve_root_symlink
		}
	}
}
