# Caddyfile fallback — dipakai HANYA jika Laravel Octane tidak ter-install.
# Mode: PHP-FPM-style biasa (tanpa worker boost), HTTP di port 8080.
# Host dibatasi APP_DOMAIN; jika kosong, menerima Host apapun.

http://{$APP_DOMAIN}:8080 {
	log {
		level WARN
		format json
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-X-Powered-By
	}

	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	route {
		root * "/app/public"
		encode zstd br gzip

		php_server {
			index index.php
			try_files {path} {path}/index.php index.php
			resolve_root_symlink
		}
	}
}
